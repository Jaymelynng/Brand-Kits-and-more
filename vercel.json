{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "gym-brand-kits.vercel.app" }],
      "destination": "https://brandkits.mygymtools.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
